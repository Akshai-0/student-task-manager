# Copy this file to ".env" and replace the placeholder values.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/student_task_manager"
PORT=5000
# Address of the React dev server (used for CORS)
CORS_ORIGIN="http://localhost:5173"
# Set to true to print the SQL generated by Prisma in the backend terminal
LOG_QUERIES=false
